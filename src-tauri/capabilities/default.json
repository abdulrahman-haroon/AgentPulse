{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: dashboard, hook status, widget toggle, open/reply to sessions. No fs, shell or http.",
  "windows": ["main"],
  "permissions": [
    "allow-dashboard",
    "allow-hook-status",
    "allow-toggle-widget",
    "allow-open-session",
    "allow-send-reply",
    "allow-cancel-reply",
    "allow-dismiss-reply"
  ]
}
