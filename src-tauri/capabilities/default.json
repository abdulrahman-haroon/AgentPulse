{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: dashboard, hooks setup, autostart, sound test, widget toggle, open/reply to sessions. No fs, shell or http.",
  "windows": ["main"],
  "permissions": [
    "allow-dashboard",
    "allow-hook-status",
    "allow-connect-hooks",
    "allow-disconnect-hooks",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-app-version",
    "allow-check-update",
    "allow-install-update",
    "allow-get-settings",
    "allow-save-settings",
    "allow-test-push",
    "allow-test-sound",
    "allow-decide-permission",
    "allow-session-history",
    "allow-toggle-widget",
    "allow-open-session",
    "allow-send-reply",
    "allow-cancel-reply",
    "allow-dismiss-reply"
  ]
}
